rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidTopicCount(t) {
      return t is map &&
        t.keys().hasAll(['correct', 'wrong']) &&
        t.keys().hasOnly(['correct', 'wrong']) &&
        t.correct is int && t.correct >= 0 && t.correct <= 1000000 &&
        t.wrong is int && t.wrong >= 0 && t.wrong <= 1000000;
    }

    function isValidTopicsMap(topics) {
      return topics is map &&
        topics.keys().hasAll([
          'LAZY_WAY', 'DATA_ANALYSIS', 'POLYNOMIALS', 'FUNCTIONS', 'QUADRATICS',
          'EXPONENTIALS', 'LINEAR_1', 'LINEAR_2', 'SYSTEMS', 'EXPR_EQ_INEQ'
        ]) &&
        topics.keys().hasOnly([
          'LAZY_WAY', 'DATA_ANALYSIS', 'POLYNOMIALS', 'FUNCTIONS', 'QUADRATICS',
          'EXPONENTIALS', 'LINEAR_1', 'LINEAR_2', 'SYSTEMS', 'EXPR_EQ_INEQ'
        ]) &&
        isValidTopicCount(topics.LAZY_WAY) &&
        isValidTopicCount(topics.DATA_ANALYSIS) &&
        isValidTopicCount(topics.POLYNOMIALS) &&
        isValidTopicCount(topics.FUNCTIONS) &&
        isValidTopicCount(topics.QUADRATICS) &&
        isValidTopicCount(topics.EXPONENTIALS) &&
        isValidTopicCount(topics.LINEAR_1) &&
        isValidTopicCount(topics.LINEAR_2) &&
        isValidTopicCount(topics.SYSTEMS) &&
        isValidTopicCount(topics.EXPR_EQ_INEQ);
    }

    function isValidStudentProgress(data) {
      return data.keys().hasAll([
          'uid', 'displayName', 'lifetimeCorrect', 'lifetimeWrong', 'topics', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'uid', 'displayName', 'lifetimeCorrect', 'lifetimeWrong', 'topics', 'createdAt', 'updatedAt'
        ]) &&
        data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 &&
        data.uid.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.uid == request.auth.uid &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120 &&
        data.lifetimeCorrect is int && data.lifetimeCorrect >= 0 && data.lifetimeCorrect <= 10000000 &&
        data.lifetimeWrong is int && data.lifetimeWrong >= 0 && data.lifetimeWrong <= 10000000 &&
        isValidTopicsMap(data.topics) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    match /studentProgress/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if false;

      allow create: if isValidId(userId) &&
        isOwner(userId) &&
        isValidStudentProgress(incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if isValidId(userId) &&
        isOwner(userId) &&
        isValidStudentProgress(incoming()) &&
        (
          incoming().diff(existing()).affectedKeys().hasOnly([
            'displayName', 'lifetimeCorrect', 'lifetimeWrong', 'topics', 'updatedAt'
          ]) &&
          incoming().uid == existing().uid &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          incoming().lifetimeCorrect >= existing().lifetimeCorrect &&
          incoming().lifetimeWrong >= existing().lifetimeWrong
        );

      allow delete: if false;
    }
  }
}
